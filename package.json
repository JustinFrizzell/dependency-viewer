{
  "scripts": {
    "prototype:visual": "node --import tsx node_modules/webpack-cli/bin/cli.js --config webpack.config.ts --mode development --disable-interpret",
    "build": "npm run build:dependency",
    "test": "npm run test:dependency",
    "test:browser": "npm run build && node --import tsx --test test/browser/*.test.ts",
    "lint": "eslint --ext .js,.cjs,.ts .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,cjs,ts,css,html,json}\" \"test/**/*.{js,cjs,ts,css,html,json}\" webpack.config.ts package.json tsconfig.json .eslintrc.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{js,cjs,ts,css,html,json}\" \"test/**/*.{js,cjs,ts,css,html,json}\" webpack.config.ts package.json tsconfig.json .eslintrc.json .prettierrc.json",
    "build:dependency": "npm run typecheck && node --import tsx node_modules/webpack-cli/bin/cli.js --config webpack.config.ts --disable-interpret",
    "test:dependency": "npm run build:dependency && node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@types/cytoscape-dagre": "^2.3.4",
    "css-loader": "^6.8.1",
    "cytoscape": "^3.35.0",
    "cytoscape-dagre": "^2.2.1",
    "esbuild-loader": "^4.4.0",
    "eslint": "^8.57.1",
    "html-inline-script-webpack-plugin": "^3.2.1",
    "html-webpack-plugin": "^5.5.3",
    "jsdom": "^26.1.0",
    "playwright": "1.56.1",
    "prettier": "^3.10.1",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "name": "dependency-viewer",
  "engines": {
    "node": ">=24"
  }
}
