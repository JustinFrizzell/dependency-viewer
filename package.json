{
  "scripts": {
    "build": "npm run build:dependency",
    "test": "npm run test:dependency",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,cjs,ts,css,html,json}\" \"test/**/*.{js,cjs,css,html,json}\" webpack.config.js package.json tsconfig.json .eslintrc.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{js,cjs,ts,css,html,json}\" \"test/**/*.{js,cjs,css,html,json}\" webpack.config.js package.json tsconfig.json .eslintrc.json .prettierrc.json",
    "build:dependency": "webpack --config webpack.config.js",
    "test:dependency": "npm run build:dependency && node --test test/*.test.cjs"
  },
  "devDependencies": {
    "css-loader": "^6.8.1",
    "cytoscape": "^3.35.0",
    "cytoscape-dagre": "^2.2.1",
    "eslint": "^8.57.1",
    "html-inline-script-webpack-plugin": "^3.2.1",
    "html-webpack-plugin": "^5.5.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.0",
    "typescript": "^7.0.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "name": "dependency-viewer"
}
